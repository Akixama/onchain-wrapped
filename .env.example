# Copy to .env.local (local dev) and add the same values in Vercel → Project → Settings → Environment Variables.

# ---- Data providers (free tiers) ----
# EVM chains (+ Solana backup) — https://dashboard.zerion.io
# Demo keys: 1 req/s, 300 req/day. Free "Developer" plan: 2,000/day.
ZERION_API_KEY=
# Solana — https://dashboard.helius.dev (free: 1M credits/month). Optional while Zerion handles Solana.
HELIUS_API_KEY=
# helius (default when HELIUS_API_KEY is set) or zerion
# SOLANA_PROVIDER=zerion

# ---- Storage (required in production) ----
# Upstash Redis free tier — https://console.upstash.com → create database → REST API section.
# (Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead; both work.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Cost protection ----
# Newest N transactions per wallet. 2000 ≈ 20 Zerion requests for a busy EVM wallet.
MAX_TXS_PER_ADDRESS=2000
# New lookups per day for everyone together. Size to your Zerion quota (demo key: ~25).
LOOKUPS_PER_DAY=25
LOOKUPS_PER_IP_HOUR=5
LOOKUPS_PER_IP_DAY=15
REQUESTS_PER_IP_MINUTE=20
# Same wallets within this many hours reuse the saved result.
RESULT_TTL_HOURS=24
# How long shared result pages stay up.
RESULT_KEEP_DAYS=90
# Any random string; IPs are hashed with it, never stored raw.
IP_HASH_SALT=
# Long random string. Usage dashboard: /api/admin/usage?key=ADMIN_KEY
ADMIN_KEY=

# ---- Roast mode (optional, paid) ----
# Leave empty for the free built-in roasts.
ANTHROPIC_API_KEY=
# Default claude-opus-5-5 ($4/$20 per M tokens). claude-haiku-5-5 is ~40x cheaper.
# ROAST_MODEL=claude-opus-5-5
# ROAST_AI=off

# ---- Site ----
# Public URL, used for share links and X previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Hide the percentile card until this many lookups exist.
MIN_PERCENTILE_POOL=30

# ---- Local dev only ----
USAGE_LOG_FILE=usage.log
